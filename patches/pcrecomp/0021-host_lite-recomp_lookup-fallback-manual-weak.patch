 runtime/win32hle/host_lite.c | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/runtime/win32hle/host_lite.c b/runtime/win32hle/host_lite.c
index 20e552a..8bbf336 100644
--- a/runtime/win32hle/host_lite.c
+++ b/runtime/win32hle/host_lite.c
@@ -122,9 +122,10 @@ recomp_func_t recomp_lookup(uint32_t va) {
         if (m == va) return recomp_dispatch_table[mid].func;
         if (m < va) lo = mid + 1; else hi = mid;
     }
-    return NULL;
+    /* fora da tabela: overrides manuais do host (DesertDroid patch 0021) */
+    return recomp_lookup_manual(va);
 }
-recomp_func_t recomp_lookup_manual(uint32_t va) { (void)va; return NULL; }
+RECOMP_WEAK recomp_func_t recomp_lookup_manual(uint32_t va) { (void)va; return NULL; }
 
 /* --------------------------------------------------------- shim registry
  * Each shim gets a synthetic VA in a reserved range that no real image uses. */
