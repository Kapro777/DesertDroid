From c3281c314e000447008a5897349199d45e1009a0 Mon Sep 17 00:00:00 2001
From: tiny <tiny@localhost>
Date: Wed, 21 Oct 2026 13:14:15 -0400
Subject: [PATCH] lift32: aceitar 'repz ret' (f3 c3, hint de predicao de
 branch) como ret normal

---
 tools/lift/lift32.py | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/tools/lift/lift32.py b/tools/lift/lift32.py
index 1cd9bf5..3afc3f1 100644
--- a/tools/lift/lift32.py
+++ b/tools/lift/lift32.py
@@ -1467,7 +1467,10 @@ class Lifter:
             lines.append("RECOMP_FLAGS_IN();")
             self._flag_state = None
 
-        elif m == 'ret' or m == 'retn':
+        elif m == 'ret' or m == 'retn' or m in ('repz ret', 'rep ret',
+                                                'repe ret', 'repne ret', 'repnz ret'):
+            # (um prefixo rep antes de ret e um hint de branch-prediction —
+            #  semanticamente identico a ret; f3 c3 = "repz ret" no capstone)
             # Pop the return address that RECOMP_CALL/ICALL pushed (esp += 4), plus
             # any stdcall callee-cleanup bytes (ret N -> esp += 4 + N). Without the
             # +4 the simulated ESP drifts down 4 bytes per call and eventually the
-- 
