From 0b9511f39505a263afdad3cac34fe89610190a78 Mon Sep 17 00:00:00 2001
From: tiny <tiny@localhost>
Date: Wed, 21 Oct 2026 12:32:25 -0400
Subject: [PATCH] win32hle: headers de tamanho na arena
 (guest_realloc/guest_free); HeapReAlloc/HeapFree/LocalFree pela arena;
 cmdline e envblock arena-backed

---
 runtime/win32hle/guest_mem.c    | 34 ++++++++++++++++++++++++++++++---
 runtime/win32hle/guest_mem.h    |  8 ++++++++
 runtime/win32hle/kernel32.c     | 20 ++++++++++++++-----
 runtime/win32hle/kernel32_crt.c | 17 +++++++++++++----
 4 files changed, 67 insertions(+), 12 deletions(-)

diff --git a/runtime/win32hle/guest_mem.c b/runtime/win32hle/guest_mem.c
index 3fdb4bd..b3b3281 100644
--- a/runtime/win32hle/guest_mem.c
+++ b/runtime/win32hle/guest_mem.c
@@ -8,11 +8,13 @@
 #include <stdio.h>
 #include <stdint.h>
 #include <stddef.h>
+#include <string.h>
 #include <sys/mman.h>
 #include "guest_mem.h"
 
 #define ARENA_BASE 0x50000000u   /* longe da imagem (0x400000..) e dos shims (0x7F000000..) */
 #define ARENA_SIZE 0x18000000ull /* 384 MB reservados; paginas so viram ao tocar */
+#define HDR 16u                  /* header escondido: [0]=tamanho [4]=magic [8]=free-magic */
 
 static volatile uint64_t g_bump;   /* offset do proximo bloco na arena */
 static int g_arena_ok;
@@ -40,9 +42,35 @@ uint32_t guest_alloc(size_t size)
     if (!g_arena_ok && !arena_init()) return 0;
     if (size == 0) size = 1;
     size = (size + 15u) & ~(size_t)15u;
-    uint64_t off = __sync_fetch_and_add(&g_bump, size);
-    if (off + size > ARENA_SIZE) return 0;
-    return ARENA_BASE + (uint32_t)off;
+    uint64_t off = __sync_fetch_and_add(&g_bump, size + HDR);
+    if (off + size + HDR > ARENA_SIZE) return 0;
+    uint32_t base = ARENA_BASE + (uint32_t)off;
+    *(uint32_t *)(uintptr_t)(base + 0)  = (uint32_t)size;
+    *(uint32_t *)(uintptr_t)(base + 4)  = 0xA110C8EDu;
+    *(uint32_t *)(uintptr_t)(base + 8)  = 0u;
+    return base + HDR;
+}
+
+uint32_t guest_realloc(uint32_t old_va, size_t newsize)
+{
+    if (!old_va) return guest_alloc(newsize);
+    if (old_va < ARENA_BASE + HDR || old_va > ARENA_BASE + (uint32_t)ARENA_SIZE)
+        return 0;                                  /* nao veio da arena: recusa */
+    uint32_t *hdr = (uint32_t *)(uintptr_t)(old_va - HDR);
+    if (hdr[1] != 0xA110C8EDu) return 0;
+    uint32_t oldsize = hdr[0];
+    uint32_t nv = guest_alloc(newsize);
+    if (nv)
+        memcpy(guest_ptr(nv), guest_ptr(old_va),
+               oldsize < newsize ? oldsize : newsize);
+    return nv;
+}
+
+void guest_free(uint32_t va)
+{
+    if (va < ARENA_BASE + HDR) return;             /* free() de nao-arena: no-op */
+    uint32_t *hdr = (uint32_t *)(uintptr_t)(va - HDR);
+    if (hdr[1] == 0xA110C8EDu) hdr[2] = 0xF4EEDBAAu;
 }
 
 uint32_t guest_alloc_at(uint32_t va, size_t size)
diff --git a/runtime/win32hle/guest_mem.h b/runtime/win32hle/guest_mem.h
index f68fb26..3f0036d 100644
--- a/runtime/win32hle/guest_mem.h
+++ b/runtime/win32hle/guest_mem.h
@@ -14,6 +14,14 @@
 /* VA de guest de um bloco novo (alinhado a 16, zerado), ou 0 se esgotado. */
 uint32_t guest_alloc(size_t size);
 
+/* Realoca: copia min(old,new) para um bloco novo (o tamanho antigo vive no
+ * header escondido). Retorna o novo VA ou 0. */
+uint32_t guest_realloc(uint32_t old_va, size_t newsize);
+
+/* Liberta (a arena e bump: hoje marca o header e nao reusa; suficiente
+ * para o boot — blocos liberados nao voltam, mas nada corrompe). */
+void guest_free(uint32_t va);
+
 /* O mesmo, em um VA pedido pelo guest (VirtualAlloc com endereco): mapeia
  * paginas reais no va. Retorna o va ou 0. */
 uint32_t guest_alloc_at(uint32_t va, size_t size);
diff --git a/runtime/win32hle/kernel32.c b/runtime/win32hle/kernel32.c
index 32ba92b..c86c9c5 100644
--- a/runtime/win32hle/kernel32.c
+++ b/runtime/win32hle/kernel32.c
@@ -18,11 +18,21 @@
 #define HEAP_ZERO_MEMORY 0x00000008u
 
 /* --- process / module --- */
-static const char g_cmdline[] = "game.exe";
+/* linha de comando: copia arena-backed (buffers de host truncam em 64-bit) */
+static uint32_t g_cmdline_va;
+static void k_GetCommandLineA(void)
+{
+    if (!g_cmdline_va) {
+        g_cmdline_va = guest_alloc(sizeof "\"FalloutNV.exe\"");  /* 16 bytes */
+        char *p = (char *)guest_ptr(g_cmdline_va);
+        strcpy(p, "\"FalloutNV.exe\"");
+    }
+    RETP(g_cmdline_va, 0);
+}
 
 static void k_GetProcessHeap(void)    { RET(0x00000001u, 0); }          /* a nonzero handle */
 static void k_GetModuleHandleA(void)  { RET(0x00400000u, 1); }          /* the image base */
-static void k_GetCommandLineA(void)   { RETP(g_cmdline, 0); }
+/* ---- (o corpo novo de k_GetCommandLineA esta acima, com g_cmdline_va) ---- */
 static void k_GetCurrentProcess(void) { RET(0xFFFFFFFFu, 0); }          /* pseudo-handle */
 static void k_GetCurrentThreadId(void){ RET((uint32_t)(uintptr_t)pthread_self(), 0); }
 static void k_ExitProcess(void)       { exit((int)A32(0)); }
@@ -38,11 +48,11 @@ static void k_HeapAlloc(void) {                                         /* (hHea
     if (flags & HEAP_ZERO_MEMORY) memset(p, 0, size);
     RETP(p, 3);
 }
-static void k_HeapFree(void)   { free(APTR(2)); RET(1, 3); }            /* (hHeap, flags, ptr) */
-static void k_HeapReAlloc(void){ RETP(realloc(APTR(2), A32(3)), 4); }   /* (hHeap, flags, ptr, size) */
+static void k_HeapFree(void)   { guest_free(A32(2)); RET(1, 3); }       /* (hHeap, flags, ptr) */
+static void k_HeapReAlloc(void){ RETP(guest_realloc(A32(2), A32(3)), 4); } /* (hHeap, flags, ptr, size) */
 static void k_HeapSize(void)   { RET(0xFFFFFFFFu, 3); }                 /* unknown; callers rarely trust it */
 static void k_LocalAlloc(void) { uint32_t flags=A32(0), n=A32(1); RETP(guest_alloc(n), 2); }
-static void k_LocalFree(void)  { free(APTR(0)); RET(0, 1); }
+static void k_LocalFree(void)  { guest_free(A32(0)); RET(0, 1); }
 
 /* VirtualAlloc(addr, size, type, protect): MEM_RESERVE/COMMIT -> arena de
  * guest (em VA baixo). Se o guest pediu endereco fixo, mapeia la. */
diff --git a/runtime/win32hle/kernel32_crt.c b/runtime/win32hle/kernel32_crt.c
index f9dcce6..eed19a0 100644
--- a/runtime/win32hle/kernel32_crt.c
+++ b/runtime/win32hle/kernel32_crt.c
@@ -9,6 +9,7 @@
 #define _GNU_SOURCE
 #include <stdint.h>
 #include <stdio.h>
+#include "guest_mem.h"
 #include <stdlib.h>
 #include <string.h>
 #include <unistd.h>
@@ -36,10 +37,18 @@ static void k_GetCPInfo(void) {                    /* (cp, &CPINFO) */
 static void k_GetStringTypeA(void) { RET(1, 5); }
 static void k_GetStringTypeW(void) { RET(1, 4); }
 
-/* --- environment block: an empty, double-NUL-terminated block --- */
-static char g_envblock[2] = { 0, 0 };
-static void k_GetEnvironmentStrings(void)   { RETP(g_envblock, 0); }
-static void k_GetEnvironmentStringsW(void)  { RETP(g_envblock, 0); }
+/* --- environment block: vazio (duplo NUL), ARENA-BACKED (host 64-bit) --- */
+static uint32_t g_envblock_va;
+static void k_GetEnvironmentStrings(void)
+{
+    if (!g_envblock_va) {
+        g_envblock_va = guest_alloc(4);
+        uint32_t *b = (uint32_t *)guest_ptr(g_envblock_va);
+        *b = 0;                                    /* "\0\0\0\0" */
+    }
+    RETP(g_envblock_va, 0);
+}
+static void k_GetEnvironmentStringsW(void) { k_GetEnvironmentStrings(); }
 static void k_FreeEnvironmentStringsA(void) { RET(1, 1); }
 static void k_FreeEnvironmentStringsW(void) { RET(1, 1); }
 static void k_GetEnvironmentVariableA(void) { RET(0, 3); }   /* not found */
-- 
2.47.3

