---
 runtime/win32hle/host_lite.c | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/runtime/win32hle/host_lite.c b/runtime/win32hle/host_lite.c
index 8bbf336..4f7b123 100644
--- a/runtime/win32hle/host_lite.c
+++ b/runtime/win32hle/host_lite.c
@@ -90,6 +90,12 @@ static uint32_t make_tib(uint32_t lo, uint32_t hi) {
     t[1]        = hi;                          /* StackBase                   */
     t[2]        = lo;                          /* StackLimit                  */
     t[0x18/4]   = tva;                         /* Self (fs:[0x18])            */
+    /* TLS estatico (DesertDroid patch 0022): o host preenche fs:[0x2C] */
+    t[0x2C/4]   = 0;
+    {
+        extern void dd_on_tib_ready(uint32_t tib_va) __attribute__((weak));
+        if (dd_on_tib_ready) dd_on_tib_ready(tva);
+    }
     return tva;
 }
 
