 runtime/win32hle/host_lite.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/runtime/win32hle/host_lite.c b/runtime/win32hle/host_lite.c
index 4f7b123..b311f75 100644
--- a/runtime/win32hle/host_lite.c
+++ b/runtime/win32hle/host_lite.c
@@ -118,6 +118,18 @@ void mach_leave(void) {
     pthread_mutex_unlock(&g_mach);
 }
 
+/* Profundidade do claim atual desta thread (0 = nao detem a maquina).
+ * O yield hook do host (recomp_yield_hook) precisa dela so para
+ * entregar a maquina no claim MAIS EXTERNO — dentro de um callback
+ * aninhado a maquina continua detida mais acima e o loop simplesmente
+ * segue (mesma regra do native32_yield). */
+int mach_depth(void) {
+    return g_ms.inited ? g_ms.depth : 0;
+}
+
+/* Profundidade do claim atual desta thread (0 = nao detem a maquina). */
+int mach_depth(void);
+
 /* ------------------------------------------------------------- dispatch
  * recomp_lookup searches the generated dispatch table (declared extern in
  * recomp_types.h; defined by the lifted program, or the selftest). */
